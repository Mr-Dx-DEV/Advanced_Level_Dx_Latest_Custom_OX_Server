add_principal identifier.fivem:8771348 qbcore.god


add_principal identifier.license:1a76b9bd3c43b3de150b4874dba2d958d1cc6a22 group.admin
add_principal identifier.license:1a76b9bd3c43b3de150b4874dba2d958d1cc6a22 qbcore.god

add_principal identifier.fivem:14586079 qbcore.god
# N3X Admin Menu ACE Permissions
add_ace group.admin n3x.admin allow 

exec permissions.cfg


## Miscellaneous ##
exec misc.cfg
